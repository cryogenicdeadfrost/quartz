# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "Fine-grained reactive web LiveView, SSR, and Flexbox TUI framework in pure OCaml"
description:
  "Quartz brings React/SolidJS ergonomics and Tailwind-style type-safe styling to OCaml with zero npm or JavaScript bundler bloat. Write declarative components once with fine-grained Signals and mount them as an interactive WebSocket LiveView web app, static HTML/CSS site, or 60fps ANSI terminal UI."
maintainer: ["Abhradeep Basak <abhradeepbasak07@gmail.com>"]
authors: ["Abhradeep Basak <abhradeepbasak07@gmail.com>"]
license: "MIT"
homepage: "https://github.com/cryogenicdeadfrost/quartz"
bug-reports: "https://github.com/cryogenicdeadfrost/quartz/issues"
depends: [
  "ocaml" {>= "4.13.0"}
  "dune" {>= "2.9" & >= "2.9"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "--promote-install-files=false"
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
  ["dune" "install" "-p" name "--create-install-files" name]
]
dev-repo: "git+https://github.com/cryogenicdeadfrost/quartz.git"
