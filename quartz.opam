# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "4.0.0"
synopsis:
  "Full-stack reactive UI, WCAG styling, middleware server, and custom renderer engine in pure OCaml"
description:
  "Quartz brings React/Svelte ergonomics, Tailwind-style type-safe CSS with WCAG 2.1 contrast math, Express/NestJS-style middleware, ISR/SSE, and multi-target custom renderers (LiveView HTML, Static SSG, Flexbox TUI, Canvas2D, Markdown, JSON Scenegraph) to OCaml with zero npm bloat."
maintainer: ["Abhradeep Basak <abhradeepbasak07@gmail.com>"]
authors: ["Abhradeep Basak <abhradeepbasak07@gmail.com>"]
license: "MIT"
homepage: "https://github.com/cryogenicdeadfrost/quartz"
bug-reports: "https://github.com/cryogenicdeadfrost/quartz/issues"
depends: [
  "ocaml" {>= "4.13.0"}
  "dune" {>= "2.9" & >= "2.9"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "--promote-install-files=false"
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
  ["dune" "install" "-p" name "--create-install-files" name]
]
dev-repo: "git+https://github.com/cryogenicdeadfrost/quartz.git"
